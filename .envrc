# direnv config — enters the nix dev shell for this repo.
#
# Setup (once per laptop):
#   1. Install direnv:        nix-env -iA nixpkgs.direnv  (or your package manager)
#   2. Hook into your shell:  https://direnv.net/docs/hook.html
#   3. From the repo root:    direnv allow
#   4. Build the venv:        ./scripts/setup-dev.sh
#
# `use flake` resolves to flake.nix's devShells.default, which is
# `import ./shell.nix` — so nixpkgs comes from flake.lock (identical on every
# machine) and shell.nix stays the single source of truth. It supplies every
# non-Python tool the automation shells out to AND puts ./.venv/bin first on
# PATH. Deliberately NOT duplicated here — this file used to PATH_add the venv
# itself, but `use flake`/`use nix` REPLACE PATH with the nix shell's own, so
# anything added beforehand ended up *behind* the nix interpreter and the venv
# silently lost. Keeping venv activation in one place (shell.nix) removes that
# ordering trap and makes `nix develop` behave identically to this.
#
# First entry downloads several hundred MB (chromium, podman, node, ...).
# For a lighter shell: `use flake .#lite` here, or `nix develop .#lite`.

if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi
use flake

# Project-local secrets / env overrides (gitignored). Optional.
[ -f .envrc.local ] && source_env .envrc.local
